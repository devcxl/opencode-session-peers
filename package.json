{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@devcxl/opencode-session-peers",
  "version": "0.1.0",
  "description": "OpenCode v2 plugin that lets sessions on the same machine message each other: list peers, send, ask and wait for a reply, hand over context.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.ts",
    "./server": "./index.ts",
    "./tui": "./src/tui/index.tsx",
    "./rpc": "./src/rpc.ts"
  },
  "files": [
    "index.ts",
    "tui.tsx",
    "src/",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "session",
    "peers",
    "messaging",
    "intercom"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.16",
    "@opencode/theme": "2.0.16",
    "@opentui/core": "0.5.12",
    "@opentui/solid": "0.5.12",
    "@types/bun": "^1.3.13",
    "solid-js": "1.9.12",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "harness": "bun scripts/harness.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  }
}
